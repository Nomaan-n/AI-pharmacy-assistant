GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
DAILY_MED_BASE_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
REQUEST_TIMEOUT_SECONDS=8
MAX_QUESTION_LENGTH=1000
ALLOW_ORIGINS=*

# No Google Cloud billing is required for medicine discovery.
# Indian brands are resolved through the dynamic India registry first.
# RxNorm and PubChem provide additional public discovery for generic/brand names.
