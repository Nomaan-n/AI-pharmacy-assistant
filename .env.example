GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
DAILY_MED_BASE_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2
REQUEST_TIMEOUT_SECONDS=8
MAX_QUESTION_LENGTH=1000
ALLOW_ORIGINS=*

# Google Agent Search (current replacement for Custom Search JSON API)
GOOGLE_API_KEY=your_google_agent_search_api_key_here
GOOGLE_SEARCH_PROJECT_ID=your_google_cloud_project_id
GOOGLE_SEARCH_ENGINE_ID=your_agent_search_app_id
GOOGLE_SEARCH_LOCATION=global
