# Optional LLM. The app remains usable with deterministic answers if omitted.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Free public drug-information services used by the grounding layer.
DAILY_MED_BASE_URL=https://dailymed.nlm.nih.gov/dailymed/services/v2
OPENFDA_BASE_URL=https://api.fda.gov/drug/label.json
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
INDIA_DRUG_DB_URL=https://drugdb.in

REQUEST_TIMEOUT_SECONDS=8
MAX_QUESTION_LENGTH=1000
ALLOW_ORIGINS=*
